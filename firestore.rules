rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'ajayparmar9801@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.role in ['user', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidHospital(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'address', 'phone', 'lat', 'lng',
          'emergency24x7', 'ambulanceAvailable', 'icuBedsAvailable',
          'verified', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'placeId', 'name', 'category', 'address', 'phone', 'lat', 'lng',
          'emergency24x7', 'ambulanceAvailable', 'icuBedsAvailable',
          'verified', 'googleMapsUri', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 256)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.category in ['hospital', 'health_center', 'trauma_center', 'clinic'] &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lng is number && data.lng >= -180 && data.lng <= 180 &&
        data.emergency24x7 is bool &&
        data.ambulanceAvailable is bool &&
        data.icuBedsAvailable is int && data.icuBedsAvailable >= 0 && data.icuBedsAvailable <= 5000 &&
        data.verified is bool &&
        (!('googleMapsUri' in data) || (data.googleMapsUri is string && data.googleMapsUri.size() <= 500)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDispatch(data) {
      return data.keys().hasAll([
          'id', 'userId', 'patientName', 'bloodGroup', 'allergies',
          'emergencyContact', 'symptomSummary', 'aiDispatchBrief',
          'urgencyLevel', 'hospitalId', 'hospitalName', 'hospitalPhone',
          'lat', 'lng', 'language', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'patientName', 'bloodGroup', 'allergies',
          'emergencyContact', 'symptomSummary', 'aiDispatchBrief',
          'urgencyLevel', 'hospitalId', 'hospitalName', 'hospitalPhone',
          'lat', 'lng', 'language', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.patientName is string && data.patientName.size() <= 120 &&
        data.bloodGroup is string && data.bloodGroup.size() <= 16 &&
        data.allergies is string && data.allergies.size() <= 300 &&
        data.emergencyContact is string && data.emergencyContact.size() <= 40 &&
        data.symptomSummary is string && data.symptomSummary.size() >= 1 && data.symptomSummary.size() <= 500 &&
        data.aiDispatchBrief is string && data.aiDispatchBrief.size() >= 1 && data.aiDispatchBrief.size() <= 2000 &&
        data.urgencyLevel in ['critical', 'high', 'moderate'] &&
        data.hospitalId is string && data.hospitalId.size() <= 128 &&
        data.hospitalName is string && data.hospitalName.size() >= 1 && data.hospitalName.size() <= 160 &&
        data.hospitalPhone is string && data.hospitalPhone.size() <= 40 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lng is number && data.lng >= -180 && data.lng <= 180 &&
        data.language in ['gu', 'hi', 'en', 'es'] &&
        data.status in ['sent', 'acknowledged', 'ambulance_dispatched', 'resolved'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(userId) && isVerified() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'user' || isBootstrappedAdmin());
      allow update: if isValidId(userId) && isVerified() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId) && isAdmin() &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == userId &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isBootstrappedAdmin() && userId != request.auth.uid;
    }

    match /hospitals/{hospitalId} {
      allow get: if isValidId(hospitalId) && (existing().verified == true || isAdmin());
      allow list: if resource.data.verified == true || isBootstrappedAdmin();
      allow create: if isValidId(hospitalId) && isAdmin() &&
        isValidHospital(incoming()) &&
        incoming().id == hospitalId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(hospitalId) && isAdmin() &&
        isValidHospital(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'placeId', 'name', 'category', 'address', 'phone', 'lat', 'lng',
          'emergency24x7', 'ambulanceAvailable', 'icuBedsAvailable',
          'verified', 'googleMapsUri', 'updatedAt'
        ]);
      allow delete: if isValidId(hospitalId) && isAdmin();
    }

    match /emergencyDispatches/{dispatchId} {
      allow get: if isValidId(dispatchId) && isVerified() &&
        (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() &&
        (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(dispatchId) && isVerified() &&
        isValidDispatch(incoming()) &&
        incoming().id == dispatchId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'sent' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(dispatchId) && isVerified() &&
        isValidDispatch(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            existing().userId == request.auth.uid &&
            existing().status != 'resolved' &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['symptomSummary', 'updatedAt'])
          )
        );
      allow delete: if isValidId(dispatchId) && isAdmin();
    }
  }
}
